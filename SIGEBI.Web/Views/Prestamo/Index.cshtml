@model IEnumerable<SIGEBI.Web.Models.Prestamo.PrestamoModel>
@{
    ViewData["Title"] = "Préstamos";
    var rol = Context.Session.GetString("Rol");
    var esAdmin = rol == "Admin";
}

<h1>Listado de Préstamos</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="fas fa-info-circle"></i> @TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<!-- Filtro por estado -->
<div class="d-flex gap-2 mb-3 flex-wrap">
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <select name="estado" class="form-control" style="max-width: 200px;">
            <option value="">-- Todos los estados --</option>
            @foreach (var est in ViewBag.Estados as List<string> ?? new List<string>())
            {
                var selected = ViewBag.EstadoSeleccionado as string == est ? "selected" : null;
                <option value="@est" selected="@selected">@est</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
    </form>

    @if (esAdmin)
    {
        <form asp-action="ExportarExcel" method="get" style="display:inline;">
            <input type="hidden" name="estado" value="@ViewBag.EstadoSeleccionado" />
            <button type="submit" class="btn btn-success">
                <i class="fas fa-file-excel"></i> Exportar a Excel
            </button>
        </form>
    }
</div>

@if (esAdmin)
{
    <p><a asp-action="Create" class="btn btn-primary">Agregar Nuevo Préstamo</a></p>
}

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                @if (esAdmin)
                {
                    <th>@Html.DisplayNameFor(m => m.prestamoId)</th>
                }
                <th>Usuario</th>
                <th>Ejemplar</th>
                <th>@Html.DisplayNameFor(m => m.fechaPrestamo)</th>
                <th>@Html.DisplayNameFor(m => m.fechaDevolucionEsperada)</th>
                <th>@Html.DisplayNameFor(m => m.estado)</th>
                @if (esAdmin)
                {
                    <th>Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @if (esAdmin)
                    {
                        <td>@Html.DisplayFor(x => item.prestamoId)</td>
                    }
                    <td>@item.nombreUsuario</td>
                    <td>@item.codigoEjemplar</td>
                    <td>@Html.DisplayFor(x => item.fechaPrestamo)</td>
                    <td>@Html.DisplayFor(x => item.fechaDevolucionEsperada)</td>
                    <td>@Html.DisplayFor(x => item.estado)</td>
                    @if (esAdmin)
                    {
                        <td>
                            @if (item.estado == "Activo")
                            {
                                <form asp-action="Devolver" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.prestamoId" />
                                    <button type="submit" class="btn btn-warning btn-sm" onclick="return confirm('¿Estás seguro de que quieres registrar la devolución de este préstamo? Esta acción no se puede deshacer.');">
                                        <i class="fas fa-undo"></i> Devolver
                                    </button>
                                </form>
                                <span>|</span>
                            }

                            @if (item.estado == "Pendiente")
                            {
                                <form asp-action="Aprobar" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.prestamoId" />
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="fas fa-check"></i> Aprobar
                                    </button>
                                </form>
                                <span>|</span>

                                <form asp-action="Rechazar" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.prestamoId" />
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Estás seguro de rechazar este préstamo?');">
                                        <i class="fas fa-times"></i> Rechazar
                                    </button>
                                </form>
                                <span>|</span>
                            }

                            @Html.ActionLink("Editar", "Edit", new { id = item.prestamoId }) |
                            @Html.ActionLink("Detalles", "Details", new { id = item.prestamoId })
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>