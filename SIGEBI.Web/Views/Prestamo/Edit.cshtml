@model SIGEBI.Web.Models.Prestamo.PrestamoEditModel
@{
    ViewData["Title"] = "Editar Préstamo";
}

<h1>Editar Préstamo</h1>
<form asp-action="Edit">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="id" />

    <div class="form-group">
        <label asp-for="usuarioId">Usuario</label>
        <select asp-for="usuarioId" asp-items="Model.UsuariosList" class="form-control">
            <option value="">-- Seleccione un usuario --</option>
        </select>
        <span asp-validation-for="usuarioId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ejemplarId">Ejemplar</label>
        <select asp-for="ejemplarId" asp-items="Model.EjemplaresList" class="form-control">
            <option value="">-- Seleccione un ejemplar --</option>
        </select>
        <span asp-validation-for="ejemplarId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="fechaPrestamo">Fecha de Préstamo</label>
        <input asp-for="fechaPrestamo" type="datetime-local" class="form-control" />
        <span asp-validation-for="fechaPrestamo" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="fechaDevolucionEsperada">Fecha de Devolución Esperada</label>
        <input asp-for="fechaDevolucionEsperada" type="datetime-local" class="form-control" />
        <span asp-validation-for="fechaDevolucionEsperada" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="estado">Estado</label>
        <select asp-for="estado" class="form-control">
            <option value="">-- Seleccione un estado --</option>
            <option value="Pendiente">Pendiente</option>
            <option value="Activo">Activo</option>
            <option value="Devuelto">Devuelto</option>
            <option value="Vencido">Vencido</option>
        </select>
        <span asp-validation-for="estado" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <input type="submit" value="Guardar" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}