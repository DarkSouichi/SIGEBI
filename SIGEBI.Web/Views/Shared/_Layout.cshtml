@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var isLoggedIn = !string.IsNullOrEmpty(
        HttpContextAccessor.HttpContext?.Session?.GetString("Token")
    );
    var rol = HttpContextAccessor.HttpContext?.Session?.GetString("Rol");
    var esAdmin = rol == "Admin";
    var nombreCompleto = HttpContextAccessor.HttpContext?.Session?.GetString("NombreCompleto") ?? "Usuario";

    var isHomePage = 
                 ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
                 ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    var containerClass = isHomePage ? "container-home" : "container-content";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIGEBI</title>
    <link rel="stylesheet" href="~/css/site.css?v=6" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />
</head>
<body>

    <div id="fondo"></div>

    <header>
        <nav class="navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/Logo.png" alt="SIGEBI" height="40" />
                    <span>SIGEBI</span>
                </a>

                <ul class="navbar-menu">
                    <li>
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-house"></i> Inicio
                        </a>
                    </li>

                    @if (esAdmin)
                    {
                        <!-- Módulos exclusivos para Admin -->
                        <li>
                            <a class="nav-link" asp-controller="Usuario" asp-action="Index">
                                <i class="fas fa-users"></i> Usuarios
                            </a>
                        </li>
                        <li>
                            <a class="nav-link" asp-controller="Recurso" asp-action="Index">
                                <i class="fas fa-book"></i> Catálogo
                            </a>
                        </li>
                        <li>
                            <a class="nav-link" asp-controller="Ejemplar" asp-action="Index">
                                <i class="fas fa-copy"></i> Ejemplares
                            </a>
                        </li>
                        <li>
                            <a class="nav-link" asp-controller="Prestamo" asp-action="Index">
                                <i class="fas fa-handshake"></i> Préstamos
                            </a>
                        </li>
                        <li>
                            <a class="nav-link" asp-controller="Penalizacion" asp-action="Index">
                                <i class="fas fa-triangle-exclamation"></i> Penalizaciones
                            </a>
                        </li>
                        <li>
                            <a class="nav-link" asp-controller="Notificacion" asp-action="Index">
                                <i class="fas fa-bell"></i> Notificaciones
                            </a>
                        </li>
                    }
                    else
                    {
                        <!-- Usuario normal -->
                        <li>
                            <a class="nav-link" asp-controller="Recurso" asp-action="Index">
                                <i class="fas fa-book"></i> Catálogo
                            </a>
                        </li>
                    }

                    @if (isLoggedIn)
                    {
                        <li>
                            <a class="nav-link" asp-controller="Auth" asp-action="Logout"
                               title="Cerrar sesión como @nombreCompleto">
                                <i class="fas fa-right-from-bracket"></i> Cerrar Sesión
                            </a>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="nav-link" asp-controller="Auth" asp-action="Login">
                                <i class="fas fa-right-to-bracket"></i> Iniciar Sesión
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <div class="@containerClass">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>
    <script>
            document.addEventListener('DOMContentLoaded', function() {
                flatpickr.localize(flatpickr.l10ns.es);
            });
    </script>

    <script>
            document.addEventListener('DOMContentLoaded', function() {
                flatpickr('.flatpickr-penalizacion', {
                    enableTime: true,
                    dateFormat: "Y-m-d H:i",
                    defaultDate: new Date(),
                    yearSelectorType: "dropdown",
                    minDate: "today",
                    locale: 'es'
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>