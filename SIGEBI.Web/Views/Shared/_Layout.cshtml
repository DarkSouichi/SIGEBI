<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIGEBI</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">SIGEBI</a>
                <div class="navbar-nav">
                    <a class="nav-link text-white" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                    <a class="nav-link text-white" asp-controller="Recurso" asp-action="Index">Catálogo</a>
                    <a class="nav-link text-white" asp-controller="Prestamo" asp-action="Index">Préstamos</a>
                    <a class="nav-link text-white" asp-controller="Penalizacion" asp-action="Index">Penalizaciones</a>
                    <a class="nav-link text-white" asp-controller="Notificacion" asp-action="Index">Notificaciones</a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>