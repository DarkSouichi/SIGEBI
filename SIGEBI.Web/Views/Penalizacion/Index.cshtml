@model IEnumerable<SIGEBI.Web.Models.Penalizacion.PenalizacionModel>
@{
    ViewData["Title"] = "Penalizaciones";
    var rol = Context.Session.GetString("Rol");
    var esAdmin = rol == "Admin";
}

<h1>Listado de Penalizaciones</h1>

<div asp-validation-summary="All" class="text-danger"></div>

@if (esAdmin)
{
    <p><a asp-action="Create" class="btn btn-primary">Agregar Nueva Penalización</a></p>
}

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.penalizacionId)</th>
            <th>Usuario</th>                      
            <th>Préstamo</th>                       
            <th>@Html.DisplayNameFor(m => m.monto)</th>
            <th>@Html.DisplayNameFor(m => m.estado)</th>
            <th>@Html.DisplayNameFor(m => m.fechaEmision)</th>
            @if (esAdmin)
            {
                <th>Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(x => item.penalizacionId)</td>
                <td>@item.nombreUsuario</td>         
                <td>@item.prestamoInfo</td>
                <td>@Html.DisplayFor(x => item.monto)</td>
                <td>@Html.DisplayFor(x => item.estado)</td>
                <td>@Html.DisplayFor(x => item.fechaEmision)</td>
                @if (esAdmin)
                {
                    <td>
                        @Html.ActionLink("Editar", "Edit", new { id = item.penalizacionId }) |
                        @Html.ActionLink("Detalles", "Details", new { id = item.penalizacionId })
                    </td>
                }
            </tr>
        }
    </tbody>
</table>