@model SIGEBI.Web.Models.Penalizacion.PenalizacionCreateModel
@{
    ViewData["Title"] = "Crear Penalización";
}

<h1>Crear Penalización</h1>
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="usuarioId">Usuario ID</label>
        <input asp-for="usuarioId" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="prestamoId">Préstamo ID</label>
        <input asp-for="prestamoId" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="monto">Monto</label>
        <input asp-for="monto" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="estado">Estado</label>
        <input asp-for="estado" class="form-control" />
    </div>
    <div class="form-group mt-2">
        <input type="submit" value="Crear" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>