@model IEnumerable<SIGEBI.Web.Models.Penalizacion.PenalizacionModel>
@{
    ViewData["Title"] = "Mis Penalizaciones";
}

<h1>Mis Penalizaciones</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.penalizacionId)</th>
            <th>@Html.DisplayNameFor(m => m.monto)</th>
            <th>@Html.DisplayNameFor(m => m.estado)</th>
            <th>@Html.DisplayNameFor(m => m.fechaEmision)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(x => item.penalizacionId)</td>
                <td>@Html.DisplayFor(x => item.monto)</td>
                <td>@Html.DisplayFor(x => item.estado)</td>
                <td>@Html.DisplayFor(x => item.fechaEmision)</td>
            </tr>
        }
    </tbody>
</table>