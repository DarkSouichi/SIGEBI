@model SIGEBI.Web.Models.Penalizacion.PenalizacionModel
@{
    ViewData["Title"] = "Detalles de la Penalización";
}

<h1>Detalles de la Penalización</h1>

<div class="details-card">
    <div class="detail-row">
        <span class="detail-label">ID</span>
        <span class="detail-value">@Model.penalizacionId</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Usuario</span>
        <span class="detail-value">@Model.usuarioId</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Préstamo</span>
        <span class="detail-value">@Model.prestamoId</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Monto</span>
        <span class="detail-value">@Model.monto</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Estado</span>
        <span class="detail-value">@Model.estado</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Fecha Emisión</span>
        <span class="detail-value">@Model.fechaEmision</span>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary">Volver al listado</a>