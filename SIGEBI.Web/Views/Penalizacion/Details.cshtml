@model SIGEBI.Web.Models.Penalizacion.PenalizacionModel
@{
    ViewData["Title"] = "Detalles de la Penalización";
    var estadoColor = Model.estado switch
    {
        "Activa" => "badge-danger",
        "Resuelta" => "badge-success",
        "Cancelada" => "badge-secondary",
        _ => "badge-info"
    };
}

<div class="details-container">
    <div class="details-header">
        <h2><i class="fas fa-triangle-exclamation"></i> Detalles de la Penalización</h2>
    </div>
    <div class="details-body">
        <div class="detail-item">
            <span class="detail-icon"><i class="fas fa-id-badge"></i></span>
            <span class="detail-label">ID</span>
            <span class="detail-value">@Model.penalizacionId</span>
        </div>
        <div class="detail-item">
            <span class="detail-icon"><i class="fas fa-user"></i></span>
            <span class="detail-label">Usuario</span>
            <span class="detail-value">@Model.nombreUsuario</span>
        </div>
        <div class="detail-item">
            <span class="detail-icon"><i class="fas fa-handshake"></i></span>
            <span class="detail-label">Préstamo</span>
            <span class="detail-value">@Model.prestamoInfo</span>
        </div>
        <div class="detail-item">
            <span class="detail-icon"><i class="fas fa-coins"></i></span>
            <span class="detail-label">Monto</span>
            <span class="detail-value">@Model.monto.ToString("C")</span>
        </div>
        <div class="detail-item">
            <span class="detail-icon"><i class="fas fa-info-circle"></i></span>
            <span class="detail-label">Estado</span>
            <span class="detail-value">
                <span class="badge @estadoColor">@Model.estado</span>
            </span>
        </div>
        <div class="detail-item">
            <span class="detail-icon"><i class="fas fa-calendar-alt"></i></span>
            <span class="detail-label">Fecha Emisión</span>
            <span class="detail-value">@Model.fechaEmision.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    </div>
    <div class="details-actions">
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Volver al listado</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.penalizacionId" class="btn btn-primary"><i class="fas fa-edit"></i> Editar</a>
        }
    </div>
</div>