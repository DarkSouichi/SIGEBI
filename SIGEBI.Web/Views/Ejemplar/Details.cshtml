@model SIGEBI.Web.Models.Ejemplar.EjemplarModel
@{
    ViewData["Title"] = "Detalles del Ejemplar";
}

<h1>Detalles del Ejemplar</h1>

<div class="details-card">
    <div class="detail-row">
        <span class="detail-label">ID</span>
        <span class="detail-value">@Model.ejemplarId</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Código de Barras</span>
        <span class="detail-value">@Model.codigoBarras</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Estado</span>
        <span class="detail-value">
            <span class="badge @(Model.estado == 0 ? "badge-success" :
                                                 Model.estado == 1 ? "badge-warning" :
                                                 Model.estado == 2 ? "badge-info" : "badge-danger")">
                @Model.EstadoTexto
            </span>
        </span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Recurso (Libro) ID</span>
        <span class="detail-value">@Model.recursoId</span>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.ejemplarId" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>