@model IEnumerable<SIGEBI.Web.Models.Usuario.UsuarioModel>
@{
    ViewData["Title"] = "Usuarios";
    var rol = Context.Session.GetString("Rol");
    var esAdmin = rol == "Admin";
}

<h1>Listado de Usuarios</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<!-- Filtros -->
<div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
    <form asp-action="Index" method="get" class="d-flex gap-2 flex-wrap align-items-center">
        <select name="rol" class="form-control" style="max-width: 120px;">
            <option value="">-- Todos --</option>
            <option value="1" selected="@(ViewBag.RolSeleccionado?.ToString() == "1" ? "selected" : null)">Admin</option>
            <option value="2" selected="@(ViewBag.RolSeleccionado?.ToString() == "2" ? "selected" : null)">Usuario</option>
        </select>
        <select name="activo" class="form-control" style="max-width: 120px;">
            <option value="">-- Activo --</option>
            <option value="true" selected="@(ViewBag.ActivoSeleccionado?.ToString() == "true" ? "selected" : null)">Sí</option>
            <option value="false" selected="@(ViewBag.ActivoSeleccionado?.ToString() == "false" ? "selected" : null)">No</option>
        </select>
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
    </form>

    @if (esAdmin)
    {
        <form asp-action="ExportarExcel" method="get" style="display:inline;">
            <input type="hidden" name="rol" value="@ViewBag.RolSeleccionado" />
            <input type="hidden" name="activo" value="@ViewBag.ActivoSeleccionado" />
            <button type="submit" class="btn btn-success" style="white-space: nowrap;">
                <i class="fas fa-file-excel"></i> Exportar a Excel
            </button>
        </form>
    }
</div>

@if (esAdmin)
{
    <p><a asp-action="Create" class="btn btn-primary">Agregar Nuevo</a></p>
}

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.usuarioId)</th>
            <th>@Html.DisplayNameFor(m => m.nombreCompleto)</th>
            <th>@Html.DisplayNameFor(m => m.email)</th>
            <th>@Html.DisplayNameFor(m => m.estaActivo)</th>
            <th>@Html.DisplayNameFor(m => m.rolId)</th>
            @if (esAdmin)
            {
                <th>Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(x => item.usuarioId)</td>
                <td>@Html.DisplayFor(x => item.nombreCompleto)</td>
                <td>@Html.DisplayFor(x => item.email)</td>
                <td>@Html.DisplayFor(x => item.estaActivo)</td>
                <td>@Html.DisplayFor(x => item.rolId)</td>
                @if (esAdmin)
                {
                    <td>
                        @Html.ActionLink("Editar", "Edit", new { id = item.usuarioId }) |
                        @Html.ActionLink("Detalles", "Details", new { id = item.usuarioId })
                    </td>
                }
            </tr>
        }
    </tbody>
</table>