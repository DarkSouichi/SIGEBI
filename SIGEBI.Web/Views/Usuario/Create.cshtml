@model SIGEBI.Web.Models.Usuario.UsuarioCreateModel
@{
    ViewData["Title"] = "Crear Usuario";
}

<h1>Crear Usuario</h1>
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="nombreCompleto">Nombre Completo</label>
        <input asp-for="nombreCompleto" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="email">Email</label>
        <input asp-for="email" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="password">Contraseña</label>
        <input asp-for="password" type="password" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="rolId">Rol ID</label>
        <input asp-for="rolId" class="form-control" />
    </div>
    <div class="form-group mt-2">
        <input type="submit" value="Crear" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>