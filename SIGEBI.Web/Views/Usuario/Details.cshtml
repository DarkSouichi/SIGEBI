@model SIGEBI.Web.Models.Usuario.UsuarioModel
@{
    ViewData["Title"] = "Detalles del Usuario";
}

<h1>Detalles del Usuario</h1>
<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.usuarioId</dd>
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.nombreCompleto</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.email</dd>
    <dt class="col-sm-2">Activo</dt>
    <dd class="col-sm-10">@Model.estaActivo</dd>
    <dt class="col-sm-2">Rol</dt>
    <dd class="col-sm-10">@Model.rolId</dd>
</dl>
<a asp-action="Index">Volver al listado</a>