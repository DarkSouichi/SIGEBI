@model SIGEBI.Web.Models.Notificacion.NotificacionModel
@{
    ViewData["Title"] = "Detalles de la Notificación";
    var esAdmin = Context.Session.GetString("Rol") == "Admin";
}

<div class="details-container">
    <div class="details-header">
        <h2><i class="fas fa-bell"></i> Detalles de la Notificación</h2>
    </div>
    <div class="details-body">
        @if (esAdmin)
        {
            <div class="detail-item">
                <span class="detail-icon"><i class="fas fa-id-badge"></i></span>
                <span class="detail-label">ID</span>
                <span class="detail-value">@Model.notificacionId</span>
            </div>
        }
        <div class="detail-item">
            <span class="detail-icon"><i class="fas fa-user"></i></span>
            <span class="detail-label">Usuario</span>
            <span class="detail-value">@Model.nombreUsuario</span>
        </div>
        <div class="detail-item">
            <span class="detail-icon"><i class="fas fa-tag"></i></span>
            <span class="detail-label">Tipo</span>
            <span class="detail-value">
                <span class="badge badge-info">@Model.tipo</span>
            </span>
        </div>
        <div class="detail-item">
            <span class="detail-icon"><i class="fas fa-comment"></i></span>
            <span class="detail-label">Mensaje</span>
            <span class="detail-value">@Model.mensaje</span>
        </div>
        <div class="detail-item">
            <span class="detail-icon"><i class="fas fa-clock"></i></span>
            <span class="detail-label">Enviado En</span>
            <span class="detail-value">@Model.enviadoEn.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <div class="detail-item">
            <span class="detail-icon"><i class="fas fa-share-alt"></i></span>
            <span class="detail-label">Canal</span>
            <span class="detail-value">@Model.canal</span>
        </div>
        <div class="detail-item">
            <span class="detail-icon"><i class="fas fa-check-circle"></i></span>
            <span class="detail-label">Estado</span>
            <span class="detail-value">
                <span class="badge @(Model.leida ? "badge-success" : "badge-danger")">
                    @(Model.leida ? "Leída" : "No leída")
                </span>
            </span>
        </div>
        @if (Model.prestamoId.HasValue || Model.recursoId.HasValue)
        {
            <div class="detail-item">
                <span class="detail-icon"><i class="fas fa-link"></i></span>
                <span class="detail-label">Referencia</span>
                <span class="detail-value">
                    @if (Model.prestamoId.HasValue)
                    {
                        <a asp-controller="Prestamo" asp-action="Details" asp-route-id="@Model.prestamoId">Ver Préstamo</a>
                    }
                    else if (Model.recursoId.HasValue)
                    {
                        <a asp-controller="Recurso" asp-action="Details" asp-route-id="@Model.recursoId">Ver Recurso</a>
                    }
                </span>
            </div>
        }
    </div>
    <div class="details-actions">
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Volver al listado</a>
        @if (!Model.leida)
        {
            <button class="btn btn-success" onclick="marcarLeida(@Model.notificacionId, this)"><i class="fas fa-check"></i> Marcar como leída</button>
        }
    </div>
</div>

@section Scripts {
    <script>
        function marcarLeida(id, element) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (!token) { alert('Token CSRF no encontrado.'); return false; }
            fetch(`/Notificacion/MarcarLeida/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: '{}'
            })
                .then(response => response.json())
                .then(data => {
                    if (data.isSuccess) {
                        location.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => alert('Error de conexión.'));
            return false;
        }
    </script>
}