@model SIGEBI.Web.Models.Notificacion.NotificacionCreateModel
@{
    ViewData["Title"] = "Crear Notificación";
}

<h1>Crear Notificación</h1>
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="usuarioId">Usuario ID</label>
        <input asp-for="usuarioId" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="tipo">Tipo</label>
        <input asp-for="tipo" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="mensaje">Mensaje</label>
        <textarea asp-for="mensaje" class="form-control" rows="3"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="canal">Canal</label>
        <input asp-for="canal" class="form-control" />
    </div>
    <div class="form-group mt-2">
        <input type="submit" value="Crear" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>