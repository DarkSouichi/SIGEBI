@model SIGEBI.Web.Models.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Registrarse";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIGEBI</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />
    <style>
            /* ===== MISMO ESTILO QUE EL LOGIN ===== */
            body {
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                margin: 0;
                background-image: url('/images/fondo.png') !important;
                background-size: cover !important;
                background-attachment: fixed !important;
                background-position: center !important;
            }

            .register-box {
                max-width: 440px;
                width: 100%;
                padding: 30px 28px;
                background: rgba(255, 255, 255, 0.85);
                backdrop-filter: blur(5px);
                border-radius: 16px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
                margin: 20px;
            }

                .register-box .icon-circle {
                    font-size: 4rem;
                    color: #2563EB;
                    text-align: center;
                    margin-bottom: 10px;
                }

                .register-box h2 {
                    text-align: center;
                    margin-bottom: 20px;
                    color: #0F172A;
                }

                .register-box .form-group {
                    margin-bottom: 18px;
                }

                    .register-box .form-group label {
                        font-weight: 500;
                        color: #0F172A;
                        display: block;
                        margin-bottom: 4px;
                    }

                    .register-box .form-group .input-icon {
                        position: relative;
                    }

                        .register-box .form-group .input-icon i {
                            position: absolute;
                            left: 14px;
                            top: 50%;
                            transform: translateY(-50%);
                            color: #94A3B8;
                            font-size: 1rem;
                        }

                .register-box .form-control {
                    width: 100%;
                    border: 2px solid #E2E8F0;
                    border-radius: 12px;
                    padding: 12px 16px 12px 44px;
                    font-size: 1rem;
                    background: white;
                    transition: border-color 0.3s, box-shadow 0.3s;
                }

                    .register-box .form-control:focus {
                        border-color: #2563EB;
                        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
                        outline: none;
                    }

                .register-box .btn-primary {
                    background: linear-gradient(135deg, #2563EB, #1D4ED8);
                    color: white;
                    padding: 12px 24px;
                    border-radius: 30px;
                    border: none;
                    font-weight: 500;
                    cursor: pointer;
                    transition: transform 0.1s;
                    width: 100%;
                    font-size: 1rem;
                }

                    .register-box .btn-primary:hover {
                        transform: translateY(-2px);
                    }

                .register-box .text-danger {
                    color: #ff3b30;
                    font-size: 0.85rem;
                }

                .register-box .login-link {
                    text-align: center;
                    margin-top: 20px;
                    font-size: 0.95rem;
                    color: #64748B;
                }

                    .register-box .login-link a {
                        color: #2563EB;
                        font-weight: 500;
                        text-decoration: none;
                    }

                        .register-box .login-link a:hover {
                            text-decoration: underline;
                        }

                .register-box .alert {
                    padding: 10px 14px;
                    border-radius: 10px;
                    margin-bottom: 16px;
                    font-weight: 500;
                    font-size: 0.9rem;
                }

                .register-box .alert-success {
                    background: #D1FAE5;
                    color: #065F46;
                    border: 1px solid #A7F3D0;
                }

                .register-box .alert-danger {
                    background: #FEE2E2;
                    color: #991B1B;
                    border: 1px solid #FECACA;
                }
    </style>
</head>
<body>

    <div class="register-box">
        <div class="icon-circle">
            <i class="fas fa-user-plus"></i>
        </div>

        <h2>Registrarse</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
            </div>
        }

        <form asp-action="Index" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <!-- ✅ Sin campo oculto de rolId (se asigna en backend) -->

            <div class="form-group">
                <label asp-for="NombreCompleto">Nombre completo</label>
                <div class="input-icon">
                    <i class="fas fa-user"></i>
                    <input asp-for="NombreCompleto" class="form-control" placeholder="Nombre completo" />
                </div>
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Correo electrónico</label>
                <div class="input-icon">
                    <i class="fas fa-envelope"></i>
                    <input asp-for="Email" class="form-control" placeholder="Correo electrónico" type="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Contraseña</label>
                <div class="input-icon">
                    <i class="fas fa-lock"></i>
                    <input asp-for="Password" class="form-control" placeholder="Contraseña" type="password" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary">
                <i class="fas fa-user-check"></i> Registrarse
            </button>

            <div class="login-link">
                ¿Ya tienes cuenta? <a asp-controller="Auth" asp-action="Login">Inicia sesión</a>
            </div>
        </form>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>